# 令牌与本地配置（重要）
app/config.local.json

# 本地数据：导入的日历快照、手动录入、收件箱
app/data/

# 依赖与缓存
.venv/
__pycache__/
*.pyc

# 编辑器自己的东西（VS Code 的 C++ 符号数据库有好几 MB，不必入库）
.vscode/
.idea/
*.code-workspace

# 生成物与预览
out/preview/
out/.lo/
out/.mpl/
# Windows 兼容性体检的报告与原始日志（tools/verify_windows.*）
out/win-verify/
out/server.log

# Office 打开文件时留下的锁文件
out/.~*
.~*

# 参考材料（体积大，不必入库）
refs/*.docx
refs/*.pptx
refs/_dumps/

# 临时
*.log
